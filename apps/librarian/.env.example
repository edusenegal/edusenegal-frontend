# Base de l'API — vide en développement : le proxy Vite relaie /api vers VITE_PROXY_TARGET.
VITE_API_BASE_URL=

# Cible du proxy de développement (api-gateway).
VITE_PROXY_TARGET=http://localhost:8000

# Base publique des fichiers MinIO. Le backend renvoie des clés relatives
# ("schools/<slug>/logo.png"), pas des URL absolues.
VITE_ASSETS_BASE_URL=http://localhost:9000/edusenegal

# Durée avant expiration à partir de laquelle le token est rafraîchi (secondes).
VITE_TOKEN_REFRESH_MARGIN=60
